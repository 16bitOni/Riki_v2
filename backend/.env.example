# Copy to backend/.env. Every setting is documented in app/config.py.

# A secret for the server (12+ characters). Required. With email sign-in (below) nobody types it; it still encrypts
# your connected apps' tokens, so keep it long and never change it casually.
RIKI_PASSWORD=

# Sign in with a code emailed to you, then stay signed in on that browser. Set all of these, or none (none = you sign
# in with RIKI_PASSWORD). Gmail: turn on 2-step verification, make an "app password" (myaccount.google.com/apppasswords),
# and use it as RIKI_SMTP_PASSWORD. Port 587 uses STARTTLS, 465 implicit TLS; plain text is never used.
# RIKI_OWNER_EMAIL=you@gmail.com
# RIKI_SMTP_HOST=smtp.gmail.com
# RIKI_SMTP_PORT=587
# RIKI_SMTP_USER=you@gmail.com
# RIKI_SMTP_PASSWORD=
# RIKI_SMTP_FROM=

# People you add in Settings > People each get a private account (chats, memory, files) on this Riki, signing in with
# their own emailed code. This is each one's own daily model spend cap in dollars; it needs RIKI_PRICES to count anything.
# RIKI_MEMBER_DAILY_BUDGET_USD=1

RIKI_DATABASE_URL=postgresql+asyncpg://riki:riki@localhost:5433/riki

# Models (LangChain "provider:model" strings). For any OpenAI-compatible server use "openai:<model name>".
RIKI_MODEL=openai:gpt-4.1-mini
RIKI_SMART_MODEL=openai:gpt-4.1
# Blank = api.openai.com. E.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1 (Ollama).
RIKI_BASE_URL=
RIKI_API_KEY=

# Embeddings: blank URL/key reuse RIKI_BASE_URL / RIKI_API_KEY.
RIKI_EMBEDDING_MODEL=openai:text-embedding-3-small
RIKI_EMBEDDING_BASE_URL=
RIKI_EMBEDDING_API_KEY=

# Bedrock instead: RIKI_MODEL=bedrock_converse:<model id>, RIKI_EMBEDDING_MODEL=bedrock:<model id>,
# credentials from `aws configure`.
# RIKI_AWS_REGION=us-east-1

RIKI_USER_NAME=Subhadip
RIKI_TIMEZONE=Asia/Kolkata
# No scheduled check-ins between these local hours ("0-0" turns quiet hours off).
RIKI_QUIET_HOURS=22-8

# Folder the filesystem MCP server may read (and, with your approval, write).
RIKI_FILES_DIR=C:/Users/subha/Documents

# GitHub MCP (set enabled: true for "github" in mcp.json): a fine-grained personal access token.
GITHUB_TOKEN=

# Limits (defaults shown)
# RIKI_MAX_DEPTH=3
# RIKI_MAX_AGENTS_PER_RUN=12
# RIKI_MAX_STEPS_PER_AGENT=12
# RIKI_RUN_TOKEN_BUDGET=300000
# Memory before each answer: heuristic (no extra model call), escalate, or llm; and how long to wait for it.
# RIKI_MEMORY_PLANNER=heuristic
# RIKI_MEMORY_TIMEOUT_S=8
# How long a change waits for your OK (default 24 h). It survives a restart and can be answered from your phone.
# RIKI_APPROVAL_TIMEOUT_S=86400
# Dollars per million tokens, keyed by the exact model string above; unlisted models show no cost.
# RIKI_PRICES={"openai:gpt-4.1-mini": {"input": 0.4, "cached": 0.1, "output": 1.6}}
# Effort when a message doesn't pick one: low (no helpers, 4 steps, 40k tokens), medium (1 level, 3 helpers,
# 8 steps, 120k), high (the limits above). See EFFORT in app/config.py.
# RIKI_DEFAULT_EFFORT=medium

# Everything below, and Telegram, can be set in the app (Settings). What you change there is stored in the database and
# wins over this file; "Reset" in Settings goes back to what is written here. Models, the database and the password
# stay here.
#
# Phone: connect Telegram in Settings > Channels (paste the @BotFather token, send the one-time code). The token is
# stored encrypted. These two lines only seed a connection once, on first start, for setups without a browser:
# RIKI_TELEGRAM_TOKEN=
# RIKI_TELEGRAM_CHAT_ID=

# Riki thinking about you between chats (a read on you, lessons, now and then one specific message). RIKI_COGNITION=false
# turns it off; a cycle with nothing new costs nothing.
# RIKI_COGNITION=true
# RIKI_COGNITION_INTERVAL_H=4

# Spend: price your models (dollars per million tokens, keyed by the exact model string) to see what every answer costs.
# With a daily budget, background work pauses at 80% and chat answers briefly at 100%.
# RIKI_DAILY_BUDGET_USD=2

# run_python: a throwaway Docker container (no network, read-only disk, 60 s). Needs Docker. Off by default.
# RIKI_SANDBOX=true
# RIKI_SANDBOX_IMAGE=python:3.12-slim
