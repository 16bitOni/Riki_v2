# Copy to backend/.env. Every setting is documented in app/config.py.

# Login password for the UI (12+ characters). Required.
RIKI_PASSWORD=

RIKI_DATABASE_URL=postgresql+asyncpg://riki:riki@localhost:5433/riki

# Models (LangChain "provider:model" strings). For any OpenAI-compatible server use "openai:<model name>".
RIKI_MODEL=openai:gpt-4.1-mini
RIKI_SMART_MODEL=openai:gpt-4.1
# Blank = api.openai.com. E.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1 (Ollama).
RIKI_BASE_URL=
RIKI_API_KEY=

# Embeddings: blank URL/key reuse RIKI_BASE_URL / RIKI_API_KEY.
RIKI_EMBEDDING_MODEL=openai:text-embedding-3-small
RIKI_EMBEDDING_BASE_URL=
RIKI_EMBEDDING_API_KEY=

# Bedrock instead: RIKI_MODEL=bedrock_converse:<model id>, RIKI_EMBEDDING_MODEL=bedrock:<model id>,
# credentials from `aws configure`.
# RIKI_AWS_REGION=us-east-1

RIKI_USER_NAME=Subhadip
RIKI_TIMEZONE=Asia/Kolkata
# No scheduled check-ins between these local hours ("0-0" turns quiet hours off).
RIKI_QUIET_HOURS=22-8

# Folder the filesystem MCP server may read (and, with your approval, write).
RIKI_FILES_DIR=C:/Users/subha/Documents

# GitHub MCP (set enabled: true for "github" in mcp.json): a fine-grained personal access token.
GITHUB_TOKEN=

# Limits (defaults shown)
# RIKI_MAX_DEPTH=3
# RIKI_MAX_AGENTS_PER_RUN=12
# RIKI_MAX_STEPS_PER_AGENT=12
# RIKI_RUN_TOKEN_BUDGET=300000
# Memory before each answer: heuristic (no extra model call), escalate, or llm; and how long to wait for it.
# RIKI_MEMORY_PLANNER=heuristic
# RIKI_MEMORY_TIMEOUT_S=8
# RIKI_APPROVAL_TIMEOUT_S=300
# Effort when a message doesn't pick one: low (no helpers, 4 steps, 40k tokens), medium (1 level, 3 helpers,
# 8 steps, 120k), high (the limits above). See EFFORT in app/config.py.
# RIKI_DEFAULT_EFFORT=medium
